NODE_ENV=development
PORT=3006

# Em produção: URL do dashboard web, sem barra no final (ex.: "https://financial.aiandralves.com.br")
FRONT_URLS="http://localhost:4213"

# Database
# Em produção: deixe em branco — o docker-compose.prod.yml preenche sozinho (aponta pro serviço "postgres" do compose).
DATABASE_URL="postgresql://docker:docker@localhost:65433/ai_financial?schema=public"

# Public URL of this API (used to build links sent by e-mail, ex: notificações futuras)
# Em produção: "https://apifinancial.aiandralves.com.br"
API_PUBLIC_URL="http://localhost:3006"

# Better Auth — login local (e-mail/senha + Google), usuário único, cadastro desabilitado.
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Em produção: "https://apifinancial.aiandralves.com.br"
BETTER_AUTH_URL="http://localhost:3006"
SESSION_EXPIRES_IN=3600          # 1 hora (em segundos)
SESSION_COOKIE_CACHE_MAX_AGE=300 # 5 minutos (em segundos)

# Login com Google (opcional) — Client ID/Secret cadastrados no Google Cloud Console.
# Sem isso preenchido, só o login por e-mail/senha funciona.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Usuário master criado por `bun run db:seed:auth` (idempotente) — é o único login válido, o
# cadastro de novos usuários fica desabilitado (app de usuário único).
SEED_MASTER_NAME="Aiandra Meira"
SEED_MASTER_EMAIL=""
SEED_MASTER_PASSWORD=""

# Resend (e-mail) — opcional até a fase de notificações
# Em produção: mesma conta/API key usada pelos outros projetos (aiandrameira).
RESEND_API_KEY=""
DEFAULT_MAIL_FROM=""

# AI Storage — API key + environment da Application "AI Financial" cadastrada lá, usada por /uploads
# (comprovantes, notas fiscais)
# Em produção: AI_STORAGE_API_URL="https://apistorage.aiandralves.com.br" e AI_STORAGE_ENVIRONMENT_ID
# precisa ser o environment de PRODUÇÃO da Application (não o de desenvolvimento local) — ver docs/deploy.md.
AI_STORAGE_API_URL="http://localhost:3008"
AI_STORAGE_API_KEY=""
AI_STORAGE_ENVIRONMENT_ID=""

# AI Flow — API key da Application "AI Financial" cadastrada lá, usada pelo job de fatura vencendo
# O AI Flow ainda não está deployado na infra compartilhada — deixe as duas em branco em produção
# por enquanto; os jobs que dependem disso avisam no log e não quebram nada quando não configurado.
AI_FLOW_API_URL="http://localhost:3007"
AI_FLOW_API_KEY=""

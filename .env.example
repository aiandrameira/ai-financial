# Usado só pelo docker-compose.prod.yml (raiz) pra configurar o Postgres.
# Copie para ".env" na raiz e preencha com uma senha forte antes de subir no VPS.
# Segredos da própria API (Resend, AI Storage, AI Flow, etc.) ficam em api/.env — ver api/.env.example.

POSTGRES_USER=ai_financial
POSTGRES_PASSWORD=
POSTGRES_DB=ai_financial
